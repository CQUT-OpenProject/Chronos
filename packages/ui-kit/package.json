{
	"name": "@chronos/ui-kit",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*",
			"default": "./src/*"
		},
		"./theme/m3-theme": {
			"types": "./src/theme/m3-theme.ts",
			"import": "./src/theme/m3-theme.ts",
			"default": "./src/theme/m3-theme.ts"
		},
		"./timetable-preview/day-labels": {
			"types": "./src/timetable-preview/day-labels.ts",
			"import": "./src/timetable-preview/day-labels.ts",
			"default": "./src/timetable-preview/day-labels.ts"
		}
	},
	"dependencies": {
		"@chronos/core": "workspace:*",
		"@ktibow/material-color-utilities-nightly": "^0.4.1772748028000"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
