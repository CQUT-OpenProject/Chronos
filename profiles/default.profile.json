{
	"$schema": "https://chronos.app/schemas/profile.schema.json",
	"profileId": "chronos-default",
	"name": "Chronos-Default",
	"version": "0.3.0",
	"description": "仅包含短链导入能力",
	"defaultTheme": "m3-default",
	"plugins": [
		{
			"id": "core-shell",
			"enabled": true
		},
		{
			"id": "codec-share",
			"enabled": true
		}
	],
	"preferences": {
