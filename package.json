{
	"name": "chronos-monorepo",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "vp -C apps/web dev",
		"build": "vp -C apps/web build",
		"build:pages": "CHRONOS_DEPLOY_TARGET=pages vp -C apps/web build && cp apps/web/build/404.html apps/web/build/index.html",
		"preview": "vp -C apps/web preview",
		"prepare": "vp config && (cd apps/web && svelte-kit sync || echo '')",
		"check": "(cd apps/web && svelte-kit sync) && vp check",
		"check:watch": "(cd apps/web && svelte-kit sync) && svelte-check --tsconfig ./apps/web/tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:unit": "(cd apps/web && vp test)",
		"test": "(cd apps/web && vp test -- --run)",
		"theme:generate": "node --experimental-strip-types scripts/generate-theme-tokens.ts",
		"icons:png": "node --experimental-strip-types scripts/generate-icons.ts",
		"bench:share-link": "node --experimental-strip-types scripts/share-link-compression-benchmark.ts"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24",
		"svelte": "^5.56.9",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
