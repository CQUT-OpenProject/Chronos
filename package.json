{
	"name": "chronos-monorepo",
	"private": true,
	"version": "0.6.1",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vp -C apps/web dev",
		"build": "vp -C apps/web build",
		"prepare": "vp config && node --experimental-strip-types apps/web/scripts/emit-profile-artifacts.ts && ln -sfn apps/web/.svelte-kit .svelte-kit"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.1",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "4.1.10"
	}
}
